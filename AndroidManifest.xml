<!--
  BestromAgent - Agent mode.

  Both services ship android:enabled="false": with the switch off,
  AccessibilityManagerService never scans this app and nothing binds it. The
  settings activity is enabled because it is the door - an activity nobody
  starts costs nothing, holds no binding and starts no process.   There is deliberately no JobService, no NotificationListenerService and no
  <provider> anywhere in this file. BrainProxyService is exported under
  USE_BRAIN so other BestROM apps can share the sealed brain key without
  reading it. The receivers are ReminderReceiver (local reminders) and BackgroundReceiver
  (jobs + macros). Neither turns Agent mode on.

  INTERNET is here for exactly one class, brain/OpenAiCompatClient. It is a
  normal permission, granted at install, so the privileged allowlist holds
  EXECUTE_APP_FUNCTIONS, WRITE_SECURE_SETTINGS, READ_LOGS, DUMP and
  PACKAGE_USAGE_STATS. The adb bridge
  itself is still a unix abstract socket with no address outside the device.

  networkSecurityConfig is what lets the two LAN presets connect at all; the
  file says why it permits cleartext and where the address rule really lives.
  usesCleartextTraffic is deliberately absent: on this API level it does
  nothing, and an attribute that does nothing reads as a protection.

  Every activity pins an empty taskAffinity. The default affinity is the
  package name, which another app can declare as its own, and the screen that
  starts an agent task is not a screen to share a task stack with.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.bestrom.agent">

    <!-- privapp allowlist: rom/privapp-permissions-com.bestrom.agent.xml -->
    <uses-permission android:name="android.permission.EXECUTE_APP_FUNCTIONS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.READ_LOGS" />
    <uses-permission android:name="android.permission.DUMP" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <!-- normal / signature, no allowlist entry -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Shared brain for platform-signed BestROM apps (Launcher, Dialer, …).
      Signature|privileged: same cert as BestromAgent, or privapp allowlisted.
      The key itself is never exported — only status + complete().
    -->
    <permission
        android:name="com.bestrom.agent.permission.USE_BRAIN"
        android:protectionLevel="signature|privileged"
        android:label="@string/perm_use_brain_label"
        android:description="@string/perm_use_brain_description" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher_agent"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/ic_launcher_agent"
        android:supportsRtl="true"
        android:theme="@style/Theme.BestromAgent">

        <!-- Settings / pairing / audit. Still reachable from Powerhub and the
             chat menu. WRITE_SECURE_SETTINGS so only Settings (and this app)
             can open it from outside. -->
        <activity
            android:name=".ui.AgentSettingsActivity"
            android:enabled="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:taskAffinity=""
            android:label="@string/agent_title"
            android:theme="@style/Theme.BestromAgent" />

        <!-- Homescreen chat + digital assistant entry.

             MAIN/LAUNCHER puts BestROM Agent on the launcher. ASSIST keeps it
             as a Default apps > Digital assistant candidate.

             exported="true" and DEFAULT are both load bearing for ASSIST.
             It reads none of what it is handed: no extras, no data, no clipboard. -->
        <activity
            android:name=".ui.AgentTaskActivity"
            android:enabled="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:label="@string/agent_task_title"
            android:theme="@style/Theme.BestromAgent.Chat"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Where the API key is typed. Not exported: an activity another app
             can start is an activity another app can put a window over. -->
        <activity
            android:name=".ui.BrainSettingsActivity"
            android:enabled="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:label="@string/brain_title"
            android:theme="@style/Theme.BestromAgent" />

        <activity
            android:name=".miniapps.WaterTrackerActivity"
            android:enabled="true"
            android:exported="false"
            android:taskAffinity=""
            android:label="@string/water_title"
            android:theme="@style/Theme.BestromAgent" />

        <activity
            android:name=".miniapps.WeightTrackerActivity"
            android:enabled="true"
            android:exported="false"
            android:taskAffinity=""
            android:label="@string/weight_title"
            android:theme="@style/Theme.BestromAgent" />

        <activity
            android:name=".miniapps.RecipeMiniAppActivity"
            android:enabled="true"
            android:exported="false"
            android:taskAffinity=""
            android:label="@string/miniapp_recipe_title"
            android:theme="@style/Theme.BestromAgent" />

        <receiver
            android:name=".miniapps.WaterWidgetProvider"
            android:exported="true"
            android:label="@string/water_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/water_widget_info" />
        </receiver>

        <receiver
            android:name=".miniapps.WeightWidgetProvider"
            android:exported="true"
            android:label="@string/weight_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weight_widget_info" />
        </receiver>

        <receiver
            android:name=".miniapps.RecipeWidgetProvider"
            android:exported="true"
            android:label="@string/miniapp_recipe_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recipe_widget_info" />
        </receiver>

        <service
            android:name=".bridge.AgentBridgeService"
            android:enabled="false"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local agent bridge, running only while Agent mode is on" />
        </service>

        <!--
             Shared brain for other BestROM apps. Always enabled; does not turn
             Agent mode on. Callers need USE_BRAIN. Never returns the API key.
        -->
        <service
            android:name=".brain.BrainProxyService"
            android:enabled="true"
            android:exported="true"
            android:permission="com.bestrom.agent.permission.USE_BRAIN">
            <intent-filter>
                <action android:name="com.bestrom.agent.action.BRAIN_PROXY" />
            </intent-filter>
        </service>

        <service
            android:name=".health.HealthProxyService"
            android:enabled="true"
            android:exported="true"
            android:permission="com.bestrom.agent.permission.USE_BRAIN">
            <intent-filter>
                <action android:name="com.bestrom.agent.action.HEALTH_PROXY" />
            </intent-filter>
        </service>

        <service
            android:name=".a11y.AgentAccessibilityService"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/agent_accessibility_service" />
        </service>

        <!-- Local reminders / deferred goals only. Does not enable Agent mode. -->
        <receiver
            android:name=".schedule.ReminderReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.bestrom.agent.action.REMINDER_FIRE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Background jobs + macros. Does not enable Agent mode. -->
        <receiver
            android:name=".jobs.BackgroundReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.bestrom.agent.action.JOB_FIRE" />
                <action android:name="com.bestrom.agent.action.MACRO_FIRE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.intent.action.BATTERY_OKAY" />
            </intent-filter>
        </receiver>

        <!--
             androidx.recyclerview drags in profileinstaller, whose manifest adds a
             ContentProvider that runs at process start and an exported receiver.
             Both are stripped here so the merged manifest keeps its promise: no
             provider and no profileinstaller receiver ship in this APK. tools:node is a merger
             directive, not a component - the merged manifest has neither element.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />

    </application>
</manifest>
