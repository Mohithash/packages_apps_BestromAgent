<!--
  BestromAgent - Agent mode.

  Both services ship android:enabled="false": with the switch off,
  AccessibilityManagerService never scans this app and nothing binds it. The
  settings activity is enabled because it is the door - an activity nobody
  starts costs nothing, holds no binding and starts no process. There is
  deliberately no <receiver>, no BOOT_COMPLETED, no JobService, no
  NotificationListenerService and no <provider> anywhere in this file.

  INTERNET is here for exactly one class, brain/OpenAiCompatClient. It is a
  normal permission, granted at install, so the privileged allowlist is
  unchanged and still holds two entries. The adb bridge itself is still a unix
  abstract socket with no address outside the device.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.bestrom.agent">

    <!-- privapp allowlist: rom/privapp-permissions-com.bestrom.agent.xml -->
    <uses-permission android:name="android.permission.EXECUTE_APP_FUNCTIONS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!-- normal / signature, no allowlist entry -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.Settings">

        <!-- No MAIN/LAUNCHER filter and no intent-filter at all: the Powerhub
             preference names this component explicitly, so nothing needs one.
             Exported, because a component in another app cannot be started
             otherwise, but behind WRITE_SECURE_SETTINGS - Settings holds it,
             an installed app does not. The switch on this screen enables a
             service that reads the screen and taps it, which is exactly the
             tap an overlay would want to steal, so the root view also sets
             filterTouchesWhenObscured. -->
        <activity
            android:name=".ui.AgentSettingsActivity"
            android:enabled="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:label="@string/agent_title" />

        <service
            android:name=".bridge.AgentBridgeService"
            android:enabled="false"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local agent bridge, running only while Agent mode is on" />
        </service>

        <service
            android:name=".a11y.AgentAccessibilityService"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/agent_accessibility_service" />
        </service>

        <!--
             androidx.recyclerview drags in profileinstaller, whose manifest adds a
             ContentProvider that runs at process start and an exported receiver.
             Both are stripped here so the merged manifest keeps its promise: no
             provider and no receiver ship in this APK. tools:node is a merger
             directive, not a component - the merged manifest has neither element.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />

    </application>
</manifest>
