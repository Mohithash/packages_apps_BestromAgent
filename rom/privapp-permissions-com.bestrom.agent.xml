<!--
  Privileged-permission allowlist for BestromAgent.
  Installed to /system_ext/etc/permissions/. It must list every signature|privileged
  permission requested by AndroidManifest.xml and nothing else, or a build with
  ro.control_privapp_permissions=enforce aborts at boot.

  The two role-only app function permissions are deliberately absent: their
  protection levels (internal|recents|role and internal|role) carry no
  privileged flag, so an entry here would be a no-op. Discovery still works,
  because searchAppFunctions accepts EXECUTE_APP_FUNCTIONS in its anyOf. Their
  names are left out of this file on purpose: the verify gate greps for them.
-->
<permissions>
    <privapp-permissions package="com.bestrom.agent">
        <permission name="android.permission.EXECUTE_APP_FUNCTIONS" />
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
    </privapp-permissions>
</permissions>
