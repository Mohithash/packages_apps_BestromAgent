android_app {
    name: "BestromAgent",

    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",

    // platform_apis, not system_current: the AppFunctions entry points are
    // @FlaggedApi and the accessibility screenshot path wants the platform
    // surface. Same shape as Launcher3QuickStep and TvSystemUI.
    platform_apis: true,
    min_sdk_version: "current",
    target_sdk_version: "current",

    certificate: "platform",
    privileged: true,
    system_ext_specific: true,

    static_libs: [
        "androidx.core_core-ktx",
        "androidx.recyclerview_recyclerview",
    ],

    // R8 off for the same reason Freezer keeps it off: the ROM build is the
    // only place it runs, so a shrinker surprise there costs more than the
    // few hundred KB it saves.
    optimize: {
        enabled: false,
    },

    required: ["privapp_whitelist_com.bestrom.agent"],
}

prebuilt_etc {
    name: "privapp_whitelist_com.bestrom.agent",
    system_ext_specific: true,
    sub_dir: "permissions",
    src: "rom/privapp-permissions-com.bestrom.agent.xml",
    filename_from_src: true,
}

// The protocol pieces that hold no Android state, compiled for the host so the
// framing, the pairing code and the rate limiter can be tested without a device.
//
// Everything listed here must stay free of android.* imports. org.json comes
// from json-prebuilt, which is the platform's own org.json built for the host,
// so the same source compiles against the framework on the device.
java_library_host {
    name: "BestromAgent-protocol",

    srcs: [
        "src/com/bestrom/agent/bridge/Framing.kt",
        "src/com/bestrom/agent/bridge/Auth.kt",
        "src/com/bestrom/agent/bridge/Peer.kt",
        "src/com/bestrom/agent/bridge/RateLimiter.kt",
        "src/com/bestrom/agent/audit/AuditBounds.kt",
        "src/com/bestrom/agent/brain/ApiKey.kt",
        "src/com/bestrom/agent/brain/AutonomyLevel.kt",
        "src/com/bestrom/agent/brain/BrainConfig.kt",
        "src/com/bestrom/agent/brain/BrainError.kt",
        "src/com/bestrom/agent/brain/ChatRequest.kt",
        "src/com/bestrom/agent/brain/ChatResponse.kt",
        "src/com/bestrom/agent/brain/OpenAiCompatClient.kt",
        "src/com/bestrom/agent/diag/LogLimits.kt",
        "src/com/bestrom/agent/diag/BatterystatsLimits.kt",
        "src/com/bestrom/agent/alert/AlertDelivery.kt",
        "src/com/bestrom/agent/ui/MarkdownLite.kt",
        "src/com/bestrom/agent/jobs/JobLimits.kt",
        "src/com/bestrom/agent/macro/MacroLimits.kt",
        "src/com/bestrom/agent/miniapps/MiniAppLimits.kt",
        "src/com/bestrom/agent/playbook/PlaybookCatalog.kt",
        "src/com/bestrom/agent/runner/FunctionCatalog.kt",
        "src/com/bestrom/agent/runner/InjectionFilter.kt",
        "src/com/bestrom/agent/runner/PolicyEngine.kt",
        "src/com/bestrom/agent/runner/StepGuard.kt",
        "src/com/bestrom/agent/runner/SystemPrompt.kt",
        "src/com/bestrom/agent/runner/Task.kt",
        "src/com/bestrom/agent/runner/Transcript.kt",
        "src/com/bestrom/agent/runner/ScreenDigest.kt",
        "src/com/bestrom/agent/runner/ToolSchema.kt",
        "src/com/bestrom/agent/schedule/ReminderTime.kt",
    ],

    static_libs: [
        "json-prebuilt",
    ],
}

java_test_host {
    name: "BestromAgentTests",

    srcs: ["tests/src/**/*.kt"],

    static_libs: [
        "BestromAgent-protocol",
        "junit",
    ],

    test_options: {
        unit_test: true,
    },
}
